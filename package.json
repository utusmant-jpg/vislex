{
  "name": "local-evidence-desk",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "tauri dev --features desktop",
    "desktop:build": "tauri build --features desktop",
    "desktop:build:x64": "tauri build --features desktop --target x86_64-pc-windows-msvc",
    "test": "vitest run",
    "test:e2e": "playwright test e2e/workspace.spec.ts",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:harness": "playwright test e2e/harness-",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run build && npm run test && npm run test:core"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.22",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "~2.12.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "~2.12.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.14.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
